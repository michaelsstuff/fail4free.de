# =============================================================================
# fail4free.de — Produktions-Vorlage für Hetzner Webhosting S
# =============================================================================
# WICHTIG:
# 1. Kopiere diese Datei AUSSERHALB dieses Git-Repos (z. B. privater Ordner).
# 2. Trage dort alle echten Werte selbst ein und lade sie manuell per FileZilla
#    als ~/laravel/.env auf Hetzner hoch.
# 3. Committe NIEMALS eine ausgefüllte .env und gib keine Secrets weiter.
# =============================================================================

APP_NAME="fail4free.de"
APP_ENV=production
# Lokal erzeugen (siehe DEPLOY.md) und im Passwortmanager sichern!
# ACHTUNG: Verlust von APP_KEY macht verschlüsselte Server-Passwörter unlesbar.
APP_KEY=base64:HIER_SELBST_ERZEUGTEN_KEY_EINTRAGEN
APP_DEBUG=false
APP_URL=https://fail4free.de

APP_LOCALE=de
APP_FALLBACK_LOCALE=de
APP_TIMEZONE=Europe/Berlin

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=daily
LOG_LEVEL=warning

# Datenbank aus konsoleH (Datenbanken -> MariaDB/MySQL)
DB_CONNECTION=mysql
DB_HOST=HIER_HETZNER_DB_HOST_EINTRAGEN
DB_PORT=3306
DB_DATABASE=HIER_DB_NAME_EINTRAGEN
DB_USERNAME=HIER_DB_USER_EINTRAGEN
DB_PASSWORD=HIER_DB_PASSWORT_EINTRAGEN

# Datei-Treiber (Hetzner Webhosting S: nur 1 DB, keine Queue-Worker)
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

CACHE_STORE=file
QUEUE_CONNECTION=sync

# E-Mail über konsoleH-Mailbox (z. B. noreply@fail4free.de)
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mail.your-server.de
MAIL_PORT=587
MAIL_USERNAME=noreply@fail4free.de
MAIL_PASSWORD=HIER_MAILBOX_PASSWORT_EINTRAGEN
MAIL_FROM_ADDRESS="noreply@fail4free.de"
MAIL_FROM_NAME="fail4free.de"

# Einmaliges Admin-Bootstrap beim ersten /__deploy-Lauf.
# NACH ERFOLGREICHEM ERST-LOGIN ADMIN_PASSWORD WIEDER AUS ~/laravel/.env LÖSCHEN!
ADMIN_NAME="Admin"
ADMIN_EMAIL="deine-admin-mail@beispiel.de"
ADMIN_PASSWORD="HIER_STARKES_STARTPASSWORT_EINTRAGEN"

# Langes zufälliges Secret für https://fail4free.de/__deploy (siehe DEPLOY.md).
# Zwischen Deploys optional leeren, dann liefert /__deploy 404.
DEPLOY_KEY=HIER_ZUFALLS_KEY_EINTRAGEN
