APP_NAME="fail4free.de"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=de
APP_FALLBACK_LOCALE=de
APP_FAKER_LOCALE=de_DE
APP_TIMEZONE=Europe/Berlin

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

DB_CONNECTION=mariadb
DB_HOST=db
DB_PORT=3306
DB_DATABASE=fail4free
DB_USERNAME=fail4free
DB_PASSWORD=localdev

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=file
QUEUE_CONNECTION=sync

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=mail.your-server.de
MAIL_PORT=587
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@fail4free.de"
MAIL_FROM_NAME="${APP_NAME}"

# Initialer Admin-Seeder (nur für lokalen Test / Erst-Setup)
ADMIN_NAME="Admin"
ADMIN_EMAIL="admin@fail4free.local"
ADMIN_PASSWORD="changeme-local-only"

# Optionaler Deploy-Key für /__deploy (leer = Route liefert 404)
DEPLOY_KEY=
